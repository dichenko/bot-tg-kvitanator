generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum OperationStatus {
  DRAFT
  CONFIRMED
  RENDERING
  RENDERED
  SENT
  FAILED
  DELETED
}

enum StatisticsChannel {
  TELEGRAM
  MAX
  UNKNOWN
}

enum RenderJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id          Int                  @id @default(autoincrement())
  telegramId  BigInt?              @unique
  maxId       BigInt?              @unique
  username    String?              @db.VarChar(64)
  firstName   String?              @db.VarChar(128)
  lastName    String?              @db.VarChar(128)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  registrationChannel StatisticsChannel @default(UNKNOWN)
  profile     EntrepreneurProfile?
  services    Service[]
  operations  Operation[]

  @@index([createdAt])
  @@map("users")
}

enum ReceiptCalculationType {
  INCOME
  INCOME_RETURN
}

model ConversationSession {
  key       String   @id @db.VarChar(128)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversation_sessions")
}

model EntrepreneurProfile {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  inn        String    @db.VarChar(12)
  ogrn       String?   @db.VarChar(15)
  ipFullName String    @db.VarChar(255)
  address    String    @db.VarChar(255)
  timeZone   String    @default("Europe/Moscow") @db.VarChar(64)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations Operation[]

  @@map("entrepreneur_profiles")
}

model Service {
  id         Int         @id @default(autoincrement())
  userId     Int
  title      String      @db.VarChar(160)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations Operation[]
  operationItems OperationItem[]

  @@index([userId, isActive])
  @@map("services")
}

model Operation {
  id                   Int                @id @default(autoincrement())
  userId               Int
  profileId            Int
  serviceId            Int?
  receiptNumber        String             @db.VarChar(32)
  innSnapshot          String             @db.VarChar(12)
  ipFullNameSnapshot   String             @db.VarChar(255)
  addressSnapshot      String             @db.VarChar(255)
  ogrnSnapshot         String?            @db.VarChar(15)
  timeZoneSnapshot     String             @default("Europe/Moscow") @db.VarChar(64)
  serviceTitleSnapshot String             @db.VarChar(160)
  amount               Decimal            @db.Decimal(12, 2)
  paymentMethod        PaymentMethod
  calculationType      ReceiptCalculationType @default(INCOME)
  status               OperationStatus    @default(DRAFT)
  channel              StatisticsChannel  @default(UNKNOWN)
  imagePath            String?            @db.VarChar(500)
  errorMessage         String?            @db.VarChar(1000)
  renderedAt           DateTime?
  sentAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  profile              EntrepreneurProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  service              Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  renderJob            RenderJob?
  items                OperationItem[]

  @@index([userId, createdAt])
  @@unique([userId, receiptNumber])
  @@map("operations")
}

// Immutable aggregates keep old reports stable even after receipt deletion.
// deliveryKey is unique only for scheduled reports (manual reports use NULL).
model StatisticsReport {
  id          String   @id @default(cuid())
  deliveryKey String?  @unique @db.VarChar(160)
  recipientId BigInt
  cutoffAt    DateTime
  timezone    String   @db.VarChar(100)
  snapshot    Json?
  state       String   @default("PREPARING") @db.VarChar(20)
  leaseUntil  DateTime
  messageId   Int?
  revision    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([recipientId, messageId])
  @@map("statistics_reports")
}

model OperationItem {
  id          Int       @id @default(autoincrement())
  operationId Int
  serviceId   Int?
  title       String    @db.VarChar(160)
  quantity    Decimal   @db.Decimal(12, 3)
  price       Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2)
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([operationId])
  @@map("operation_items")
}

model RenderJob {
  id           Int             @id @default(autoincrement())
  operationId  Int             @unique
  status       RenderJobStatus @default(PENDING)
  attempts     Int             @default(0)
  errorMessage String?         @db.VarChar(1000)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  operation    Operation       @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@map("render_jobs")
}
